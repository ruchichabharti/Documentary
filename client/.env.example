# ==============================================================================
# DocMind Client Environment Variables Example
# Duplicate this file as client/.env for local development.
# In Vercel, add these keys under: Project Settings > Environment Variables.
# ==============================================================================

# 1. Supabase Configuration (Required for live auth and cloud vector persistence)
# Find these in Supabase Dashboard: Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. AI Model Configuration (Required for AI Semantic Embeddings & Answer Generation)
# Free Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative OpenAI API Key (if preferred over Gemini)
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# 3. Collaboration Server Endpoints (Optional: For real-time multi-user live editing)
# If you deploy the server/ folder to a Node host (e.g. Render/Railway):
# VITE_API_URL=https://your-docmind-server.onrender.com
# VITE_WS_URL=wss://your-docmind-server.onrender.com
# For local development:
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
